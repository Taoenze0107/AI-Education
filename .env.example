# OpenAI API key. Keep it on the server; never put it in browser JavaScript.
OPENAI_API_KEY=

# Change this to any model available to your OpenAI project.
OPENAI_MODEL=gpt-5-mini

# Optional OpenAI-compatible endpoint. Leave empty for the official endpoint.
OPENAI_BASE_URL=

# Ready to use without an API key. Set true AND add a key to use a model.
# False keeps all diagnosis in the local deterministic rules engine.
ENABLE_LLM=false

# Local persistence and knowledge-base locations.
DATABASE_PATH=data/adaptive_tutor.db
KNOWLEDGE_BASE_PATH=app/data/knowledge_base.json
LLM_TIMEOUT_SECONDS=45

# Optional persistent SQLite-compatible Turso database for cloud hosting.
# Set BOTH values on Render's Environment page, never in GitHub source.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Enable on Render to refuse startup if cloud database credentials are missing.
REQUIRE_PERSISTENT_DATABASE=false
